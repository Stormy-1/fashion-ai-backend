# ============================================================
# .env.example — Environment Variable Template
# ============================================================
# COPY this file to .env and fill in your real values.
# NEVER commit the actual .env file to GitHub.
# This .env.example IS safe to commit — it shows structure, not secrets.
#
#   cp .env.example .env
# ============================================================

# ── Environment ───────────────────────────────────────────
# Options: "development" | "production"
ENVIRONMENT=development

# ── Google Gemini API ─────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
# Your Google AI Pro subscription covers this.
GOOGLE_API_KEY=your_gemini_api_key_here

# ── SerpApi (Google Shopping) ─────────────────────────────
# Free tier: 100 searches/month — enough for dev + demo
# Sign up at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# ── Model Paths ───────────────────────────────────────────
# LOCAL development — relative paths from project root
AGE_GENDER_MODEL_PATH=model_weights/age_gender_model.pth
FACIAL_FEATURE_MODEL_PATH=model_weights/celeba_imbalance_aware_classifier.pth
AGE_SCALER_PATH=model_weights/age_scaler.pkl

# COLAB — uncomment and update these when running in Google Colab
# AGE_GENDER_MODEL_PATH=/content/drive/MyDrive/fashion-ai/models/age_gender_model.pth
# FACIAL_FEATURE_MODEL_PATH=/content/drive/MyDrive/fashion-ai/models/celeba_imbalance_aware_classifier.pth
# AGE_SCALER_PATH=/content/drive/MyDrive/fashion-ai/models/age_scaler.pkl

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
